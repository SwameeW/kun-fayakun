{
  "name": "kun-fayakun",
  "version": "0.1.0",
  "private": true,
  "description": "An immersive 3D reflection on creation: Quranic verses and authentic hadith beside real cosmological data.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "validate": "tsx scripts/validate.ts",
    "fetch:quran": "tsx scripts/fetch-quran.ts",
    "preprocess:cmb": "bash scripts/preprocess-cmb.sh",
    "preprocess:calligraphy": "tsx scripts/build-calligraphy.ts",
    "test": "playwright test",
    "check": "npm run validate && npm run typecheck && npm run lint && npm run build && npm test",
    "fetch:font": "tsx scripts/fetch-font.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "preprocess:sdss": "bash scripts/preprocess-sdss.sh",
    "preprocess:jpl": "bash scripts/preprocess-jpl.sh",
    "preprocess:analysis": "tsx scripts/build-analysis.ts"
  },
  "dependencies": {
    "intl-messageformat": "12.1.4",
    "satellite.js": "7.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "harfbuzzjs": "1.6.4",
    "msdfgen-wasm": "1.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "wawoff2": "2.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
